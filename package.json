{
  "name": "ai-academic-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "AI Academic Assistant - modular monolith built with Next.js and TypeScript.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "arch:check": "node tests/architecture/check-module-boundaries.mjs",
    "arch:test": "node --test tests/architecture/check-module-boundaries.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run arch:check && npm run arch:test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "^5.9.3"
  }
}
